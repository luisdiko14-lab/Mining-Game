<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="BlockCraft"
    Manufacturer="BlockCraft Project"
    Version="$(var.ProductVersion)"
    UpgradeCode="{1B0A9EB5-6DC4-4FB1-A0A9-6EF5E9EEC07D}"
    Scope="perMachine"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of BlockCraft is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="BlockCraft" Level="1">
      <ComponentGroupRef Id="GameFiles" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
      <ComponentGroupRef Id="DesktopShortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BlockCraft" />
    </StandardDirectory>
    <ComponentGroup Id="GameFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuBlockCraft" Name="BlockCraft" />
    </StandardDirectory>
    <ComponentGroup Id="StartMenuShortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuBlockCraft" Guid="*">
        <Shortcut Id="StartMenuBlockCraft" Name="BlockCraft" Target="[INSTALLFOLDER]BlockCraft.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveBlockCraftStartMenu" On="uninstall" />
        <RegistryValue Root="HKLM" Key="Software\BlockCraft" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="DesktopShortcuts">
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
        <Shortcut Id="DesktopBlockCraft" Name="BlockCraft" Target="[INSTALLFOLDER]BlockCraft.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\BlockCraft" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
